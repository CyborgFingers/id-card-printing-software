<Project Sdk="Microsoft.NET.Sdk">
  <!-- The service: web API, encrypted database, print queue. Cross-platform so it can run on a Mac for development. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdCard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The screens (HTML/CSS/JS) are served from wwwroot next to the program. -->
    <Content Include="..\..\..\web\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="IdCard.Tests" />
  </ItemGroup>
</Project>
