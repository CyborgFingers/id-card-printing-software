<Project Sdk="Microsoft.NET.Sdk">
  <!-- ID Card Printing Software Free - Copyright (c) 2026 Josh McNabb. All rights reserved. -->
  <!-- Test harness for WindowsPrinter. Publish it self-contained so the Windows PC needs no .NET (command in Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>IdCard.PrintCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\IdCard.Desktop\Printing\*.cs" Link="Printing\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\IdCard.Core\IdCard.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>
</Project>
